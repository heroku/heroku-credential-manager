{
  "type": "module",
  "name": "@heroku/heroku-credential-manager",
  "version": "0.0.0",
  "description": "Heroku credential management for the CLI",
  "author": "Heroku",
  "repository": {
    "type": "git",
    "url": "https://github.com/heroku/heroku-credential-manager.git"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "devDependencies": {
    "@heroku-cli/test-utils": "0.1.1",
    "@types/chai": "^4.3.13",
    "@types/chai-as-promised": "^8.0.2",
    "@types/debug": "^4.1.1",
    "@types/fs-extra": "^11.0.4",
    "@types/mocha": "^10.0.10",
    "@types/nock": "^11.1.0",
    "@types/node": "^22.15.3",
    "@types/sinon": "^17.0.4",
    "@types/sinon-chai": "^4.0.0",
    "c8": "^7.7.0",
    "chai": "^4.4.1",
    "chai-as-promised": "^8.0.1",
    "eslint": "^9.26.0",
    "eslint-config-oclif": "^5.0.0",
    "eslint-config-oclif-typescript": "^3.1.14",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-mocha": "^10.4.3",
    "fs-extra": "^11.3.3",
    "mocha": "^11.7.5",
    "nock": "^13.5.0",
    "sinon": "^18.0.1",
    "sinon-chai": "^3.7.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@heroku/js-blanket": "^1.0.0",
    "debug": "^4.4.0",
    "execa": "^9.6.1"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run clean && tsc",
    "clean": "rm -rf dist",
    "lint": "eslint . --ext .ts --config .eslintrc.cjs",
    "test": "c8 mocha --forbid-only \"test/**/*.test.ts\"",
