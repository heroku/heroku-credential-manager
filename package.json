{
  "type": "module",
  "name": "@heroku/heroku-credential-manager",
  "version": "0.0.0",
  "description": "Heroku credential management for the CLI",
  "author": "Heroku",
  "repository": {
    "type": "git",
    "url": "https://github.com/heroku/heroku-credential-manager.git"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "devDependencies": {
    "@heroku-cli/test-utils": "0.1.1",
    "@types/chai": "^4.3.13",
    "@types/chai-as-promised": "^8.0.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.0.10",
    "@types/sinon": "^21.0.0",
    "@types/sinon-chai": "^4.0.0",
    "c8": "^10.1.3",
    "chai": "^6.2.2",
    "chai-as-promised": "^8.0.1",
    "eslint": "^9.39.2",
    "eslint-config-oclif": "^6.0.135",
    "eslint-config-oclif-typescript": "^3.1.14",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-mocha": "^11.2.0",
    "mocha": "^11.7.5",
    "sinon": "^21.0.1",
    "sinon-chai": "^4.0.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run clean && tsc",
    "clean": "rm -rf dist",
    "lint": "eslint . --ext .ts --config .eslintrc.cjs",
    "test": "c8 mocha --forbid-only \"test/**/*.test.ts\"",
    "test:local": "c8 mocha \"${npm_config_file:-test/**/*.test.+(ts|tsx)}\""
