{
  "type": "module",
  "name": "@heroku/heroku-credential-manager",
  "version": "0.1.0",
  "description": "Heroku credential management for the CLI",
  "author": "Heroku",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/heroku/heroku-credential-manager.git"
  },
  "publishConfig": {
    "access": "restricted"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./login": {
      "types": "./dist/login/index.d.ts",
      "default": "./dist/login/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "devDependencies": {
    "@heroku-cli/test-utils": "1.0.2",
    "@types/chai": "^4.3.13",
    "@types/chai-as-promised": "^8.0.2",
    "@types/debug": "^4.1.13",
    "@types/fs-extra": "^11.0.4",
    "@types/mocha": "^10.0.10",
    "@types/nock": "^11.1.0",
    "@types/node": "^26.6.2",
    "@types/sinon": "^17.0.4",
    "@types/sinon-chai": "^4.0.0",
    "c8": "^7.7.0",
    "chai": "^4.4.1",
    "chai-as-promised": "^8.0.1",
    "eslint": "^10",
    "eslint-config-oclif": "^6",
    "fs-extra": "^11.4.0",
    "mocha": "^10.8.2",
    "nock": "^14",
    "rimraf": "^6.1.3",
    "sinon": "^18.0.1",
    "sinon-chai": "^3.7.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@heroku/js-blanket": "^1.0.0",
    "debug": "^4.4.0",
    "execa": "^9.6.1"
  },
  "engines": {
    "node": ">=20.5.0"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^9.0.7"
    },
    "mocha": {
      "serialize-javascript": "^7.1.1"
    }
  },
  "scripts": {
    "prepare": "npm run build",
    "build": "npm run clean && tsc",
    "clean": "rimraf dist",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test/tsconfig.json",
    "unit": "node scripts/run-unit.mjs --forbid-only",
    "test": "npm run unit",
    "test:watch": "node scripts/run-unit.mjs --watch",
    "test:coverage": "node scripts/run-unit.mjs --coverage --forbid-only",
    "test:local": "node scripts/run-unit.mjs",
    "test:package": "npm run build && node scripts/test-package.mjs",
    "validate": "npm run typecheck && npm run build && npm run lint && npm run unit && npm run test:package"
  }
}
